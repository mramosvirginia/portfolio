---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import { nav, footer, home, cvUrl, email, linkedinUrl, type Locale } from '../data/site';

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const t = nav[locale];
const f = footer[locale];
const ctaTalk = home[locale].ctaTalk;

// Build the equivalent path in the other language for the language switcher.
// Static builds emit "/work/" (trailing slash) while the dev server serves
// "/work" — normalize so the active-page checks below work in both.
const rawPath = Astro.url.pathname;
const currentPath = rawPath.length > 1 && rawPath.endsWith('/') ? rawPath.slice(0, -1) : rawPath;
const otherLocale: Locale = locale === 'en' ? 'es' : 'en';
// Spanish is the default locale and lives at "/"; English lives under "/en".
const otherHref =
  locale === 'es'
    ? `/en${currentPath === '/' ? '' : currentPath}`
    : currentPath.replace(/^\/en/, '') || '/';

const isCaseStudy = /^(\/en)?\/projects\//.test(currentPath);

// Nav hrefs + which one matches the current page, for the active-page indicator.
const homeHref = locale === 'es' ? '/' : '/en/';
const workHref = locale === 'es' ? '/work' : '/en/work';
const aboutHref = locale === 'es' ? '/about' : '/en/about';
const labHref = locale === 'es' ? '/lab' : '/en/lab';
// currentPath has no trailing slash, so strip it from the href too (English home is "/en/").
const isActive = (href: string) => currentPath === (href.length > 1 ? href.replace(/\/$/, '') : href);
const isWorkActive = isActive(workHref) || currentPath.includes('/projects/');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL('/og-image.jpg', Astro.site)} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'es_ES'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-image.jpg', Astro.site)} />

    <!--
      Spanish is the default language and lives at "/", so there is nothing to
      redirect: just remember which language the visitor last used.
    -->
    <script is:inline>
      localStorage.setItem('lang', window.location.pathname.indexOf('/en') === 0 ? 'en' : 'es');
    </script>

    <!--
      Theme is set synchronously, before first paint, using an inline
      (non-deferred) script. This is what prevents the flash-of-wrong-theme
      you saw on the Framer site when navigating between pages: by the time
      the browser paints anything, data-theme is already correct.
    -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var theme = stored || 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Stack+Sans+Headline:wght@400;500;600;700&family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{locale === 'en' ? 'Skip to content' : 'Saltar al contenido'}</a>
    <header class:list={['site-header', { 'is-home': isActive(homeHref), 'is-case': isCaseStudy, 'is-plain': !isActive(homeHref) && !isCaseStudy }]}>
      <div class="container header-inner">
        <a href={homeHref} class="brand">
          Virginia M.
        </a>

        <nav class="main-nav">
          <a href={homeHref} class:list={{ active: isActive(homeHref) }}>{t.home}</a>
          <a href={workHref} data-nav-work class:list={{ active: isWorkActive }}>{t.work}</a>
          <a href={aboutHref} class:list={{ active: isActive(aboutHref) }}>{t.about}</a>
          <a href={labHref} class:list={{ active: isActive(labHref) }}>{t.lab}</a>
        </nav>

        <div class="header-controls">
          <a
            href={cvUrl}
            target="_blank"
            rel="noopener"
            class="cv-link"
            aria-label={locale === 'en' ? 'Download CV' : 'Descargar CV'}
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16"/></svg>
            <span>{t.cv}</span>
          </a>

          <a href={otherHref} class="lang-switch" aria-label="Switch language">
            {otherLocale.toUpperCase()}
          </a>

          <button
            id="theme-toggle"
            class="theme-toggle"
            aria-label={locale === 'en' ? 'Toggle dark mode' : 'Cambiar modo oscuro'}
            type="button"
          >
            <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
            <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
          </button>

          <button
            id="menu-toggle"
            class="menu-toggle"
            aria-label={locale === 'en' ? 'Open menu' : 'Abrir menú'}
            data-close-label={locale === 'en' ? 'Close menu' : 'Cerrar menú'}
            aria-expanded="false"
            aria-controls="mobile-nav"
            type="button"
          >
            <svg class="icon-burger" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
            <svg class="icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        </div>
      </div>

      <nav id="mobile-nav" class="mobile-nav">
        <a href={homeHref} class:list={{ active: isActive(homeHref) }}>{t.home}</a>
        <a href={workHref} class:list={{ active: isWorkActive }}>{t.work}</a>
        <a href={aboutHref} class:list={{ active: isActive(aboutHref) }}>{t.about}</a>
        <a href={labHref} class:list={{ active: isActive(labHref) }}>{t.lab}</a>
        <a href={cvUrl} target="_blank" rel="noopener" class="mobile-cv">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16"/></svg>
          {locale === 'en' ? 'Download CV' : 'Descargar CV'}
        </a>
      </nav>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-dots" aria-hidden="true"></div>
      <div class="footer-dots-spotlight" aria-hidden="true"></div>
      <div class="container footer-grid">
        <div class="footer-brand">
          <h2>{f.connectTitle}</h2>
          <slot name="footer" />
        </div>
        <nav class="footer-col" aria-label={f.siteLabel}>
          <p class="footer-heading">{f.siteLabel}</p>
          <a href={homeHref}>{t.home}</a>
          <a href={workHref}>{t.work}</a>
          <a href={aboutHref}>{t.about}</a>
          <a href={labHref}>{t.lab}</a>
        </nav>
        <div class="footer-col footer-contact" aria-label={f.contactLabel}>
          <p class="footer-heading">{f.contactLabel}</p>
          <a href={`mailto:${email}`}>Email</a>
          <a href={linkedinUrl} target="_blank" rel="noopener">LinkedIn</a>
          <a href={cvUrl} target="_blank" rel="noopener">{f.downloadCv}</a>
        </div>
        <a href={`mailto:${email}`} class="footer-cta">{ctaTalk}<svg class="footer-cta-arrow" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg></a>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('theme-toggle');
      btn?.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
      });

      const menuBtn = document.getElementById('menu-toggle');
      const mobileNav = document.getElementById('mobile-nav');
      const openLabel = menuBtn?.getAttribute('aria-label') || 'Open menu';
      const closeLabel = menuBtn?.dataset.closeLabel || 'Close menu';
      menuBtn?.addEventListener('click', () => {
        const isOpen = mobileNav?.classList.toggle('is-open');
        menuBtn.setAttribute('aria-expanded', String(!!isOpen));
        menuBtn.setAttribute('aria-label', isOpen ? closeLabel : openLabel);
      });
      mobileNav?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          mobileNav.classList.remove('is-open');
          menuBtn?.setAttribute('aria-expanded', 'false');
          menuBtn?.setAttribute('aria-label', openLabel);
        });
      });

      // Case studies end flush with the right edge of the "Work" nav link:
      // publish that distance (viewport right edge -> link's right edge) as a CSS variable.
      const workLink = document.querySelector('[data-nav-work]');
      const syncCaseInset = () => {
        if (!workLink) return;
        const r = workLink.getBoundingClientRect();
        if (r.width > 0) {
          document.documentElement.style.setProperty(
            '--case-right-inset',
            `${Math.round(document.documentElement.clientWidth - r.right)}px`
          );
        }
      };
      syncCaseInset();

      // Footer dot pattern: cursor "spotlight" driven by two CSS variables
      // (rAF-throttled), only on hover-capable fine-pointer devices.
      if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        const footerEl = document.querySelector('.site-footer');
        if (footerEl) {
          let frame = 0, px = 0, py = 0;
          footerEl.addEventListener('mousemove', (e) => {
            const rect = footerEl.getBoundingClientRect();
            px = e.clientX - rect.left;
            py = e.clientY - rect.top;
            if (frame) return;
            frame = requestAnimationFrame(() => {
              footerEl.style.setProperty('--mouse-x', `${px}px`);
              footerEl.style.setProperty('--mouse-y', `${py}px`);
              frame = 0;
            });
          });
        }
      }
      window.addEventListener('resize', syncCaseInset);
      document.fonts?.ready.then(syncCaseInset);

      // Auto-hide header: hide when scrolling down, show when scrolling up.
      const header = document.querySelector('.site-header');
      let lastY = window.scrollY;
      let ticking = false;
      const updateHeader = () => {
        const y = window.scrollY;
        const menuOpen = mobileNav?.classList.contains('is-open');
        header?.classList.toggle('is-scrolled', y > 8);
        if (y <= 8 || menuOpen) {
          header?.classList.remove('is-hidden');
        } else if (Math.abs(y - lastY) > 6) {
          header?.classList.toggle('is-hidden', y > lastY && y > 80);
        }
        lastY = y;
        ticking = false;
      };
      updateHeader();
      window.addEventListener('scroll', () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(updateHeader);
        }
      }, { passive: true });

      // Enable transitions only after the first paint, so the initial
      // theme application never visibly animates.
      requestAnimationFrame(() => {
        document.body.classList.add('theme-ready');
      });
    </script>

    <Analytics />

    <style>
      .skip-link {
        position: absolute;
        top: -100%;
        left: var(--space-4);
        z-index: 100;
        background: var(--bg-surface);
        color: var(--text-primary);
        border: 1px solid var(--border-default);
        border-radius: var(--radius-sm);
        padding: var(--space-2) var(--space-4);
        font-family: var(--font-mono);
        font-size: 0.8rem;
        transition: top 0.15s ease;
      }
      .skip-link:focus {
        top: var(--space-4);
      }
      .site-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 50;
        /* Transparent at the top of every page; once scrolled (or while the
           mobile menu is open) it becomes a translucent, blurred bar so the
           content underneath stays legible without a hard gray block. */
        background: transparent;
        -webkit-backdrop-filter: blur(0);
        backdrop-filter: blur(0);
        transition: transform 0.25s ease, opacity 0.25s ease, background-color 0.25s ease,
          backdrop-filter 0.25s ease, -webkit-backdrop-filter 0.25s ease;
      }
      /* Auto-hide: slides away on scroll down, returns on scroll up. */
      .site-header.is-hidden {
        transform: translateY(-100%);
        opacity: 0;
        pointer-events: none;
      }
      .site-header.is-scrolled,
      .site-header:has(.mobile-nav.is-open) {
        background: color-mix(in srgb, var(--bg-page) 55%, transparent);
        -webkit-backdrop-filter: blur(16px) saturate(1.3);
        backdrop-filter: blur(16px) saturate(1.3);
      }
      /* Open mobile menu: a bit more opaque so the links stay readable. */
      .site-header:has(.mobile-nav.is-open) {
        background: color-mix(in srgb, var(--bg-page) 80%, transparent);
      }
      /* The header is out of flow, so reserve its height. */
      :global(main) {
        padding-top: var(--header-h);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-block: var(--space-4);
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        font-family: var(--font-headline);
        font-size: 1.1rem;
      }
      .main-nav {
        display: flex;
        margin-left: auto;
        margin-right: var(--nav-gap);
        gap: var(--space-6);
        font-size: 0.9rem;
      }
      .main-nav a {
        color: var(--text-muted);
        font-family: var(--font-mono);
        text-transform: uppercase;
        letter-spacing: 0.02em;
        font-size: 0.8rem;
        transition: color 0.18s ease;
      }
      .main-nav a:hover,
      .main-nav a.active {
        color: var(--text-primary);
      }
      .header-controls {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        min-width: var(--controls-w);
        gap: var(--space-3);
      }
      .lang-switch {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 36px;
        min-height: 36px;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        padding: var(--space-1) var(--space-3);
        border: 1px solid var(--border-default);
        border-radius: var(--radius-sm);
        background: var(--bg-surface);
        color: var(--text-secondary);
      }
      .theme-toggle {
        display: grid;
        place-items: center;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 1px solid var(--border-default);
        background: var(--bg-surface);
        color: var(--text-primary);
        cursor: pointer;
      }
      .icon-moon { display: none; }
      :global([data-theme='dark']) .icon-sun { display: none; }
      :global([data-theme='dark']) .icon-moon { display: block; }

      .cv-link {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 36px;
        gap: var(--space-1);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        padding: var(--space-1) var(--space-3);
        border: 1px solid var(--border-default);
        border-radius: var(--radius-sm);
        background: var(--bg-surface);
        color: var(--text-secondary);
      }
      .cv-link:hover { color: var(--accent-highlight); }
      .cv-link span { display: inline; }

      .menu-toggle {
        display: none;
        place-items: center;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 1px solid var(--border-default);
        background: var(--bg-surface);
        color: var(--text-primary);
        cursor: pointer;
      }
      .icon-close { display: none; }
      .menu-toggle[aria-expanded='true'] .icon-burger { display: none; }
      .menu-toggle[aria-expanded='true'] .icon-close { display: block; }

      .mobile-nav {
        display: none;
        flex-direction: column;
        gap: var(--space-1);
        padding: var(--space-4) var(--space-6) var(--space-6);
        border-top: 1px solid var(--border-default);
        /* transparent: shows the header's own background, so bar and menu match */
        background: transparent;
        max-height: calc(100svh - var(--header-h));
        overflow-y: auto;
      }
      .mobile-nav.is-open { display: flex; }
      .mobile-nav a {
        padding-block: var(--space-2);
        font-family: var(--font-mono);
        text-transform: uppercase;
        letter-spacing: 0.02em;
        font-size: 0.85rem;
        color: var(--text-muted);
        transition: color 0.18s ease;
      }
      .mobile-nav a:hover {
        color: var(--text-primary);
      }
      .mobile-nav a.active {
        color: var(--text-primary);
      }
      .mobile-cv {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        margin-top: var(--space-2);
        padding-top: var(--space-4);
        border-top: 1px solid var(--border-default);
        color: var(--text-primary) !important;
      }

      /* Always black with white text, in both themes: the tokens are redefined
         locally so every child (including slotted content) picks them up. */
      .site-footer {
        --text-primary: #ffffff;
        --text-secondary: #d9d9d9;
        --text-muted: #9b9b9b;
        --border-default: #2b2b2b;
        --accent-highlight: #ffffff;
        background: #000;
        color: #fff;
        position: relative;
        overflow: hidden;
        border-top: 1px solid var(--border-default);
        padding-top: calc(var(--space-16) * 1.75);
        padding-bottom: calc(var(--space-16) * 0.75);
        margin-top: var(--space-16);
      }
      /* Halftone dot grid (same effect as the old hero): two dot layers at
         different scales, faint white on the black footer. A second, brighter
         layer is revealed only inside a soft radial mask following the cursor. */
      .footer-dots,
      .footer-dots-spotlight {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background-size: 56px 56px, 28px 28px;
        background-position: 0 0, 14px 14px;
      }
      .footer-dots {
        background-image:
          radial-gradient(circle, #fff 1.6px, transparent 1.6px),
          radial-gradient(circle, #fff 1px, transparent 1px);
        opacity: 0.045;
      }
      .footer-dots-spotlight {
        display: none;
        background-image:
          radial-gradient(circle, #fff 2.4px, transparent 2.4px),
          radial-gradient(circle, #fff 1.6px, transparent 1.6px);
        opacity: 0.7;
        -webkit-mask-image: radial-gradient(circle 80px at var(--mouse-x, -9999px) var(--mouse-y, -9999px), black 0%, transparent 100%);
        mask-image: radial-gradient(circle 80px at var(--mouse-x, -9999px) var(--mouse-y, -9999px), black 0%, transparent 100%);
      }
      @media (hover: hover) and (pointer: fine) {
        .footer-dots-spotlight { display: block; }
      }
      .footer-grid {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: 1fr minmax(160px, auto) minmax(160px, auto);
        gap: var(--space-8);
        /* Approximate width left for the title: container minus the two link
           columns (~344px incl. their 64px gap) and the right-hand inset that
           keeps the links away from the edge. */
        --footer-links-inset: clamp(40px, 7vw, 130px);
        --footer-col1: calc(min(100vw, 1920px) - var(--gutter) * 2 - 344px - var(--footer-links-inset));
      }
      @media (min-width: 901px) {
        .footer-grid {
          grid-template-columns: minmax(0, 1fr) max-content max-content;
        }
        /* Tighter gap between the Site and Contact columns. */
        .footer-col + .footer-col { margin-left: var(--space-8); }
        .footer-contact { margin-right: var(--footer-links-inset); }
        /* Two rows: title + link columns on top, copyright (left) and the CTA
           (right) on the bottom row, level with each other like in the hero. */
        .footer-grid { row-gap: clamp(160px, 20vw, 340px); }
        .footer-grid > .footer-brand { display: contents; }
        .footer-grid > .footer-brand h2 { grid-column: 1; grid-row: 1; margin-bottom: 0; }
        .footer-grid > .footer-brand :global(p) {
          grid-column: 1;
          grid-row: 2;
          align-self: end;
          margin-top: 0;
        }
        .footer-col { grid-row: 1; }
        .footer-cta {
          grid-column: 2 / 4;
          grid-row: 2;
          justify-self: end;
          align-self: end;
          margin-right: var(--footer-links-inset);
        }
      }
      .footer-brand {
        display: flex;
        flex-direction: column;
        height: 100%;
      }
      .footer-brand h2 {
        /* Size scales with the space left of the link columns; the narrow width
           cap (in em, so it tracks the size) makes it break into 3 lines in both languages. */
        font-size: clamp(2.25rem, calc(var(--footer-col1) / 14.2), 5.5rem);
        margin-bottom: var(--space-4);
        line-height: 1.02;
        max-width: 11em;
        text-wrap: balance;
      }
      /* Same treatment as the hero's "Let's talk!" link: Briem, underlined, with an arrow. */
      .footer-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.3em;
        font-family: var(--font-headline);
        font-size: 22px;
        line-height: 1.25;
        color: var(--text-primary);
        text-decoration: underline;
        text-decoration-thickness: 1.5px;
        text-underline-offset: 0.2em;
      }
      @media (hover: hover) {
        .footer-cta:hover { opacity: 0.6; }
      }
      .footer-brand :global(p) {
        font-family: var(--font-mono);
        font-size: 0.95rem;
        color: var(--text-muted);
        text-transform: uppercase;
        margin-top: auto;
      }
      .footer-col {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
      }
      .footer-heading {
        font-family: var(--font-mono);
        font-size: 0.95rem;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        color: var(--text-muted);
        margin-bottom: var(--space-1);
      }
      .footer-col a {
        color: var(--text-secondary);
        font-family: var(--font-sans);
        font-size: 1.2rem;
      }
      .footer-col a:hover {
        color: var(--accent-highlight);
      }

      @media (max-width: 640px) {
        .main-nav { display: none; }
        .menu-toggle { display: grid; }
        .header-controls { gap: var(--space-3); }
        .cv-link { display: none; }
        /* Title higher up; Site and Contact side by side, brand block and CTA full width. */
        .site-footer { padding-top: calc(var(--space-16) * 0.75); }
        /* Phone footer as one shared grid: the link columns dissolve into it
           (display: contents) so Site and Contact stay close together while the CTA
           sits right under the title. Rows: title / CTA / headings / links / copyright. */
        .footer-grid { grid-template-columns: max-content max-content 1fr; gap: var(--space-3) var(--space-8); }
        .footer-brand, .footer-col { display: contents; }
        .footer-grid > .footer-brand h2 { grid-column: 1 / -1; grid-row: 1; margin-bottom: var(--space-2); }
        .footer-cta { grid-column: 1 / -1; grid-row: 2; justify-self: start; margin: 0; }
        .footer-grid > nav.footer-col > .footer-heading { grid-column: 1; grid-row: 3; margin: var(--space-3) 0 0; }
        .footer-grid > .footer-contact > .footer-heading { grid-column: 2; grid-row: 3; margin: var(--space-3) 0 0; }
        .footer-grid > nav.footer-col > a { grid-column: 1; }
        .footer-grid > nav.footer-col > a:nth-of-type(1) { grid-row: 4; }
        .footer-grid > nav.footer-col > a:nth-of-type(2) { grid-row: 5; }
        .footer-grid > nav.footer-col > a:nth-of-type(3) { grid-row: 6; }
        .footer-grid > nav.footer-col > a:nth-of-type(4) { grid-row: 7; }
        .footer-grid > .footer-contact > a { grid-column: 2; }
        .footer-grid > .footer-contact > a:nth-of-type(1) { grid-row: 4; }
        .footer-grid > .footer-contact > a:nth-of-type(2) { grid-row: 5; }
        .footer-grid > .footer-contact > a:nth-of-type(3) { grid-row: 6; }
        .footer-grid > .footer-brand :global(p) { grid-column: 1 / -1; grid-row: 8; margin-top: var(--space-4); }
        .footer-dots, .footer-dots-spotlight { background-size: 36px 36px, 18px 18px; background-position: 0 0, 9px 9px; }
        .footer-brand h2 { max-width: none; font-size: 1.75rem; }
        /* Smaller footer text on phones. */
        .footer-brand :global(p) { font-size: 0.75rem; }
        .footer-heading { font-size: 0.75rem; }
        .footer-col a { font-size: 1rem; }
        .footer-cta { font-size: 18px; }
        .footer-brand { height: auto; }
        .footer-brand :global(p) { margin-top: var(--space-4); }
      }
    </style>
  </body>
</html>
