---
import { home, type Locale } from '../data/site';
import type { CaseStudyContent } from '../data/caseStudyTypes';
import Img from './Img.astro';
import { getImage } from '../lib/images';

interface Props {
  locale: Locale;
  study: CaseStudyContent;
}

const { locale, study } = Astro.props;
const t = home[locale];
const base = locale === 'es' ? '' : '/en';
const workHref = `${base}/work/`;
const backLabel = locale === 'en' ? 'Back to work' : 'Volver a trabajo';
const tocLabel = locale === 'en' ? 'On this page' : 'En esta página';
const impactLabel = locale === 'en' ? 'Impact:' : 'Impacto:';
const videoLabels = locale === 'en'
  ? { pause: 'Pause animation', play: 'Play animation' }
  : { pause: 'Pausar animación', play: 'Reproducir animación' };

const captionHtml = (image: { caption?: string; captionLink?: { text: string; href: string } }) => {
  const esc = (v: string) => v.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const { caption, captionLink } = image;
  if (!caption) return '';
  if (!captionLink || !caption.includes(captionLink.text)) return `(${esc(caption)})`;
  const [before, ...rest] = caption.split(captionLink.text);
  return `(${esc(before)}<a href="${captionLink.href}" target="_blank" rel="noopener">${esc(captionLink.text)}</a>${esc(rest.join(captionLink.text))})`;
};

const toc = [
  { id: 'overview', label: study.overviewTitle },
  { id: 'challenge', label: study.challengeTitle },
  ...(study.objectives ? [{ id: 'objectives', label: study.objectives.title }] : []),
  ...study.sections.map((s) => ({ id: s.id, label: s.title })),
];

// Portrait covers (e.g. Aurora Dorada, 4:5) keep their own ratio instead of being cropped to 16:9.
const heroMeta = study.heroImage ? getImage(study.heroImage) : null;
const heroPortrait = !!heroMeta && heroMeta.height > heroMeta.width;
const heroRatio = heroPortrait && heroMeta ? `${heroMeta.width} / ${heroMeta.height}` : undefined;
const contentSizes = '(min-width: 901px) calc(100vw - 356px), calc(100vw - 32px)';
const relatedSizes = '(min-width: 901px) calc((100vw - 404px) / 3), calc(100vw - 32px)';

const related = t.projects.filter((p) => p.filter === study.filter && !p.href.includes(`/${study.slug}/`)).slice(0, 3);
---

<article class="case-study">
  <div class="container case-layout">
    <aside class="case-sidebar">
      <a href={workHref} class="back-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        {backLabel}
      </a>
      <nav class="toc-nav" aria-label={study.title}>
        <p class="toc-label">{tocLabel}</p>
        <div class="toc">
          {toc.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}
        </div>
      </nav>
    </aside>

    <div class="case-content">
      <header class="case-hero">
        <h1>{study.title}</h1>
        {study.heroCtaHref && (
          <a href={study.heroCtaHref} target="_blank" rel="noopener" class="hero-cta">{study.heroCtaLabel}</a>
        )}
      </header>
      {study.heroImage ? (
        <div class:list={['hero-image', 'has-image', { 'is-portrait': heroPortrait }]} style={heroRatio ? `--hero-ar: ${heroRatio}` : undefined}>
          <Img src={study.heroImage} alt={study.heroAlt ?? study.title} sizes={contentSizes} loading="eager" />
        </div>
      ) : (
        <div class="hero-image" aria-hidden="true"></div>
      )}
      {study.highlight && (
        <p class="case-highlight"><strong>{impactLabel}</strong> <span data-countup>{study.highlight}</span></p>
      )}

      <section id="overview" class="case-section">
        {study.stack && (
          <div class="stack-block">
            <p class="stack-label">{study.stackLabel}</p>
            <ul class="stack-list">
              {study.stack.map((tool) => <li>{tool}</li>)}
            </ul>
          </div>
        )}
        <h2>{study.overviewTitle}</h2>
        <p>{study.overviewIntro}</p>
        <dl class="meta-grid">
          <div>
            <dt>{study.metaLabels.client}</dt>
            <dd>{study.meta.client}</dd>
          </div>
          <div>
            <dt>{study.metaLabels.industry}</dt>
            <dd>{study.meta.industry}</dd>
          </div>
          <div>
            <dt>{study.metaLabels.year}</dt>
            <dd>{study.meta.year}</dd>
          </div>
          <div>
            <dt>{study.metaLabels.services}</dt>
            <dd>{study.meta.services}</dd>
          </div>
        </dl>
        {study.overviewImages?.map((image) => (
          <figure class="figure-image">
            <Img class="section-image has-image" src={image.src} alt={image.alt} sizes={contentSizes} />
            {image.caption && <figcaption set:html={captionHtml(image)} />}
          </figure>
        ))}
      </section>

      <section id="challenge" class="case-section">
        <h2>{study.challengeTitle}</h2>
        <p>{study.challengeBody}</p>
        {study.roleLabel && study.role && (
          <p class="role-line"><strong>{study.roleLabel}</strong> · {study.role}</p>
        )}
        {study.creditLink && (
          <a href={study.creditLink.href} target="_blank" rel="noopener" class="credit-link">{study.creditLink.label}</a>
        )}
        {study.roleImages?.map((image) => (
          <figure class="figure-image">
            <Img class="section-image has-image" src={image.src} alt={image.alt} sizes={contentSizes} />
            {image.caption && <figcaption set:html={captionHtml(image)} />}
          </figure>
        ))}
      </section>

      {study.objectives && (
        <section id="objectives" class="case-section">
          <h2>{study.objectives.title}</h2>
          <div class="objectives-grid">
            <div>
              <p class="objectives-label">{study.objectives.businessLabel}</p>
              <ul>
                {study.objectives.business.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div>
              <p class="objectives-label">{study.objectives.userLabel}</p>
              <ul>
                {study.objectives.user.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
        </section>
      )}

      {study.sections.map((section) => (
        <section id={section.id} class="case-section">
          <h2>{section.title}</h2>
          {section.paragraphs?.map((p) => <p>{p}</p>)}
          {section.items && (
            <ul>
              {section.items.map((item) => <li>{item}</li>)}
            </ul>
          )}
          {section.labeledItems && (
            <ul class="iterations-list">
              {section.labeledItems.map((item) => (
                <li><strong>{item.label}:</strong> {item.body}</li>
              ))}
            </ul>
          )}
          {section.table && (
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    {section.table.headers.map((h) => <th scope="col">{h}</th>)}
                  </tr>
                </thead>
                <tbody>
                  {section.table.rows.map((row) => (
                    <tr>
                      {row.map((cell) => <td>{cell}</td>)}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
          {section.video && (
            <div class="video-wrap">
              <video class="section-video" src={`${section.video}#t=0.1`} aria-label={section.videoAlt ?? section.title} loop muted playsinline preload="metadata"></video>
              <button
                type="button"
                class="video-toggle"
                hidden
                aria-label={videoLabels.pause}
                data-label-pause={videoLabels.pause}
                data-label-play={videoLabels.play}
              >
                <svg class="video-icon-pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
                <svg class="video-icon-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 4l14 8-14 8V4z"/></svg>
              </button>
            </div>
          )}
          {section.images?.map((image) => (
            <figure class="figure-image">
              <Img class="section-image has-image" src={image.src} alt={image.alt} sizes={contentSizes} />
              {image.caption && <figcaption set:html={captionHtml(image)} />}
            </figure>
          ))}
        </section>
      ))}

      {related.length > 0 && (
        <section class="related">
          <h2>{study.viewMoreWork}</h2>
          <div class="related-grid">
            {related.map((p) => (
              <a href={p.href} class="related-card">
                <div class={`related-thumb ${p.image ? 'has-image' : ''}`}>
                  {p.image && <Img src={p.image} alt="" sizes={relatedSizes} widths={[320, 480, 640, 900]} />}
                </div>
                <p>{p.title}</p>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </div>
</article>

<script>
  import '../scripts/countup';
  const links = document.querySelectorAll<HTMLAnchorElement>('.toc a');
  const sections = Array.from(links)
    .map((link) => document.querySelector(link.getAttribute('href') || ''))
    .filter((el): el is Element => !!el);

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        links.forEach((link) => link.classList.remove('is-active'));
        const active = document.querySelector(`.toc a[href="#${entry.target.id}"]`);
        active?.classList.add('is-active');
      });
    },
    { rootMargin: '-20% 0px -70% 0px' }
  );

  sections.forEach((section) => observer.observe(section));

  // Section videos (WCAG 2.2.2): they only autoplay when the visitor hasn't asked for reduced
  // motion, and a visible pause/play button is always available. Without JS the video simply
  // stays on its first frame and the button stays hidden.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('.video-wrap').forEach((wrap) => {
    const video = wrap.querySelector<HTMLVideoElement>('video');
    const button = wrap.querySelector<HTMLButtonElement>('.video-toggle');
    if (!video || !button) return;
    const sync = () => {
      wrap.classList.toggle('is-paused', video.paused);
      button.setAttribute('aria-label', (video.paused ? button.dataset.labelPlay : button.dataset.labelPause) || '');
    };
    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);
    button.addEventListener('click', () => {
      if (video.paused) void video.play();
      else video.pause();
    });
    button.hidden = false;
    sync();
    if (!reduceMotion) video.play().catch(() => {});
  });
</script>

<style>
  .case-study {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }
  .case-layout {
    display: grid;
    grid-template-columns: var(--col1) 1fr;
    gap: var(--space-16);
    align-items: start;
  }
  /* Content (columns 2-3) ends at the same x as the navbar's link block. */
  @media (min-width: 901px) {
    .case-layout {
      padding-right: calc(var(--gutter) + var(--inset-right));
      /* Narrow reading column (max 880px), pushed to the right so it always
         ends flush with the navbar links, even on large screens. */
      grid-template-columns: var(--col1) minmax(0, 880px);
      justify-content: space-between;
    }
  }
  /* From 1200px up there is room to end flush with the "Work" link (measured
     in the layout script); below that the column would get too narrow, so it
     keeps ending at the last nav link. */
  @media (min-width: 1200px) {
    .case-layout {
      padding-right: var(--case-right-inset, calc(var(--gutter) + var(--inset-right)));
    }
  }
  .case-sidebar {
    position: sticky;
    top: calc(var(--header-h) + var(--space-4));
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }
  .back-link:hover {
    color: var(--accent-highlight);
  }
  .toc-label {
    display: none;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    margin-bottom: var(--space-3);
  }
  .toc {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .toc a {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--text-muted);
    line-height: 1.4;
  }
  .toc a.is-active {
    color: var(--text-primary);
    font-weight: 700;
  }
  .toc a:hover {
    color: var(--accent-highlight);
  }

  .case-content {
    min-width: 0;
  }
  .case-hero {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  .case-hero h1 {
    font-size: var(--text-case-title);
    max-width: 34ch;
  }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--accent-cta-text);
    background: var(--accent-cta);
    border-radius: 999px;
    padding: var(--space-2) var(--space-4);
    white-space: nowrap;
  }
  .hero-image {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-image);
    background: var(--bg-surface-subtle);
    border: 1px solid var(--border-default);
    margin-bottom: var(--space-16);
    overflow: hidden;
  }
  .hero-image.has-image {
    background: none;
    border: none;
  }
  .case-highlight {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin-top: calc(var(--space-16) * -1 + var(--space-4));
    /* Equal breathing room above and below the divider line (the section's border-top). */
    margin-bottom: calc(var(--space-6) + var(--space-1));
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--text-muted);
  }
  .case-highlight strong {
    color: var(--text-primary);
  }
  .case-highlight::before {
    content: '+';
    color: var(--accent-highlight);
    font-size: 1.3em;
    font-weight: 700;
  }
  .hero-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Portrait cover: full column width (same as the title) at the image's own ratio,
     so nothing is cropped; it is simply taller than a landscape cover. */
  .hero-image.is-portrait {
    aspect-ratio: var(--hero-ar);
  }
  .hero-image.is-portrait :global(img) {
    object-fit: contain;
  }

  .case-section {
    padding-top: var(--space-16);
    border-top: 1px solid var(--border-default);
    margin-top: var(--space-16);
    scroll-margin-top: var(--space-8);
  }
  .case-section:first-of-type {
    margin-top: 0;
  }
  .case-section h2 {
    font-size: var(--text-case-section);
    margin-bottom: var(--space-4);
  }
  .case-section p {
    max-width: 75ch;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-4);
  }
  .case-section p:last-child {
    margin-bottom: 0;
  }
  .case-section ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    color: var(--text-secondary);
    line-height: 1.6;
    padding-left: var(--space-6);
  }
  .role-line {
    color: var(--text-secondary);
  }
  .role-line strong {
    color: var(--text-primary);
  }
  .credit-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-primary);
    text-decoration: underline;
  }

  .meta-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-default);
  }
  .meta-grid dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--text-muted);
    margin-bottom: var(--space-1);
  }
  .meta-grid dd {
    font-size: 0.9rem;
    color: var(--text-primary);
    margin: 0;
  }

  .stack-block {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    /* Tight row gap so the STACK label sits right above the pills when they wrap. */
    gap: var(--space-2) var(--space-3);
    /* Pulls up into the section's own padding-top (space-16), so it sits
       close to the impact line/divider above instead of floating in the
       middle of that gap. */
    margin-top: calc(var(--space-6) + var(--space-1) - var(--space-16));
    margin-bottom: calc(var(--space-6) + var(--space-1));
  }
  .case-section .stack-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--text-muted);
    margin-bottom: 0;
    flex-shrink: 0;
  }
  .case-section .stack-list {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding-left: 0;
    margin: 0; /* drop the default list margins that pushed it away from the label */
  }
  .stack-list li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    border: 1px solid var(--border-default);
    border-radius: 999px;
    padding: var(--space-1) var(--space-3);
  }

  .objectives-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
  }
  .objectives-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--text-muted);
    margin-bottom: var(--space-3);
  }
  .objectives-grid ul {
    padding-left: var(--space-6);
  }

  .table-wrap {
    overflow-x: auto;
    margin-bottom: var(--space-6);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  th {
    text-align: left;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--text-muted);
    padding: var(--space-3);
    border-bottom: 1px solid var(--border-default);
  }
  td {
    padding: var(--space-3);
    color: var(--text-secondary);
    border-bottom: 1px solid var(--border-default);
    vertical-align: top;
  }

  figure {
    margin: var(--space-6) 0 0;
  }
  :global(.section-image) {
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-image);
    background: var(--bg-surface-subtle);
    border: 1px solid var(--border-default);
  }
  :global(.section-image.has-image) {
    aspect-ratio: auto;
    width: 100%;
    height: auto;
    display: block;
  }
  .video-wrap {
    position: relative;
    margin-top: var(--space-6);
  }
  .video-wrap .section-video { margin-top: 0; }
  .video-toggle {
    position: absolute;
    right: 12px;
    bottom: 12px;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    color: #fff;
    background: rgba(0, 0, 0, 0.62);
    cursor: pointer;
  }
  .video-toggle:hover { background: rgba(0, 0, 0, 0.8); }
  .video-toggle .video-icon-play { display: none; }
  .video-wrap.is-paused .video-toggle .video-icon-pause { display: none; }
  .video-wrap.is-paused .video-toggle .video-icon-play { display: block; }
  .section-video {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-image);
    border: 1px solid var(--border-default);
    margin-top: var(--space-6);
  }
  figcaption :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  figcaption {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: var(--space-2);
    text-align: center;
  }

  .iterations-list {
    padding-left: 0 !important;
  }
  .iterations-list li {
    list-style: none;
  }
  .iterations-list strong {
    color: var(--text-primary);
  }

  .related {
    padding-top: var(--space-16);
    border-top: 1px solid var(--border-default);
    margin-top: var(--space-16);
  }
  .related h2 {
    font-size: var(--text-h4);
    margin-bottom: var(--space-6);
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }
  .related-thumb {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-image);
    background: var(--bg-surface-subtle);
    border: 1px solid var(--border-default);
    margin-bottom: var(--space-3);
    overflow: hidden;
  }
  .related-thumb.has-image {
    background: none;
  }
  .related-thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .related-card p {
    font-family: var(--font-headline);
    font-size: var(--text-case-related-card);
    color: var(--text-primary);
    line-height: 1.3;
  }

  @media (max-width: 900px) {
    .case-layout { grid-template-columns: 1fr; }
    .case-sidebar { position: static; }
    .toc-label { display: block; }
    .toc { flex-direction: row; flex-wrap: wrap; gap: var(--space-2); }
    .toc a {
      border: 1px solid var(--border-default);
      border-radius: 999px;
      padding: 6px var(--space-3);
    }
    .toc a.is-active {
      background: var(--bg-surface-subtle);
      border-color: var(--accent-highlight);
    }
    .meta-grid { grid-template-columns: 1fr 1fr; }
    .objectives-grid { grid-template-columns: 1fr; gap: var(--space-6); }
    .related-grid { grid-template-columns: 1fr; }
    table { min-width: 480px; }
    th, td { white-space: normal; min-width: 160px; }
  }
  @media (max-width: 640px) {
