---
import { Image } from 'astro:assets';
import { getImage } from '../lib/images';

interface Props {
  src: string;
  alt: string;
  sizes: string;
  widths?: number[];
  /** Only the first, above-the-fold image of a page should be "eager". */
  loading?: 'lazy' | 'eager';
  class?: string;
}

const { src, alt, sizes, widths = [400, 640, 828, 1200, 1656], loading = 'lazy', class: className } = Astro.props;
const eager = loading === 'eager';
---

<Image
  src={getImage(src)}
  alt={alt}
  sizes={sizes}
  widths={widths}
  format="webp"
  quality={75}
  loading={loading}
  decoding={eager ? 'sync' : 'async'}
  fetchpriority={eager ? 'high' : undefined}
  class={className}
/>
