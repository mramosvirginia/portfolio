---
import { home, email, type Locale } from '../data/site';
import Img from './Img.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = home[locale];
const base = locale === 'en' ? '' : '/es';

// Hero tags laid out in explicit rows of 2-3 so each row hugs its content.
const heroTags = [...t.availability.slice(1), ...t.tags];
const heroTagRows = [heroTags.slice(0, 2), heroTags.slice(2)];
// Phone layout is 2 / 2 / 1: a break marker sits before the last tag.

// One icon per process card, matched by index — not translated content,
// so kept separate from the locale-aware copy in site.ts.
const processIcons = [
  // 0 — Design with intention first (target/focus)
  '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="0.5" fill="currentColor"/></svg>',
  // 1 — Strategy and pixel (swap arrows)
  '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M4 8h13M17 8l-3-3M17 8l-3 3M20 16H7M7 16l3-3M7 16l3 3"/></svg>',
  // 2 — Scalable by design systems (stacked layers)
  '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M12 3l9 5-9 5-9-5 9-5z"/><path d="M3 13l9 5 9-5"/></svg>',
  // 3 — Different formats, same eye
  '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>',
];
---

<section class="hero">
  <div class="hero-stack">
    <div class="hero-headline">
      <h1 class="hero-name">
        <span class="hero-line">{t.heroName}</span>
        <span class="hero-line">{t.heroRole}</span>
      </h1>
      <div class="hero-meta-list">
        {heroTagRows.map((row) => (
          <ul class="tag-row">
            {row.map((item, i) => (
              <>
                {row.length > 2 && i === row.length - 1 && <li class="tag-br" aria-hidden="true" />}
                <li>{item}</li>
              </>
            ))}
          </ul>
        ))}
      </div>
    </div>

    <div class="hero-bottom">
      <p class="hero-intro"><span class="hero-intro-lead">{t.heroIntro}</span> {t.heroIntroRest} <span class="hero-location">{t.heroLocation}</span></p>
      <a href={`mailto:${email}`} class="btn btn-primary">{t.ctaTalk}<svg class="btn-arrow" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg></a>
    </div>
  </div>
</section>

<section class="case-studies">
  <div class="container grid-3">
    <div class="section-head">
      <p class="eyebrow">{t.caseStudiesEyebrow}</p>
      <h2>{t.caseStudiesTitle}</h2>
      <a href={`${base}/work`} class="process-more-link">
        {t.seeAllWork}
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
    <div class="span-23">
    <div class="project-grid">
      {t.projects.map((p, i) => (
        <a href={p.href} class="project-card">
          <div class={`project-thumb thumb-ratio-${i % 4} ${p.image ? 'has-image' : ''}`}>
            {p.image && <Img src={p.image} alt="" sizes="(min-width: 781px) calc((100vw - 96px) / 2), calc(100vw - 32px)" widths={[400, 640, 900, 1200]} loading={i === 0 ? 'eager' : 'lazy'} />}
            <div class="project-overlay">
              <span class="overlay-pill">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                {t.viewCaseStudy}
              </span>
            </div>
          </div>
          <p class="project-meta">{p.year} · {p.category}</p>
          <p class="project-title">{p.cardTitle ?? p.title}</p>
          {p.impact && <p class="project-impact">{p.impact}</p>}
        </a>
      ))}
    </div>
    </div>
  </div>
</section>

<section class="process">
  <div class="container grid-3">
    <div class="section-head">
      <p class="eyebrow">{t.processEyebrow}</p>
      <h2>{t.processTitle}</h2>
      <a href={`${base}/about`} class="process-more-link">
        {t.processMoreLink}
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
    <div class="span-23">
      <div class="process-grid">
        {t.process.map((item, i) => (
          <div class="process-card">
            <div class="card-top">
              <div class="card-icon" set:html={processIcons[i]} />
              <span class="card-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <div class="card-text">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="faq">
  <div class="container grid-3">
    <div class="section-head">
      <p class="eyebrow">{t.faqEyebrow}</p>
      <h2>{t.faqTitle}</h2>
    </div>
    <div class="span-23">
    <div class="faq-list">
      {t.faq.map((item) => (
        <details class="faq-item">
          <summary>
            <span>{item.question}</span>
            <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
    </div>
  </div>
</section>

<script>
  // Scroll reveal for "Selected work": same rise + fade as the hero, fired
  // when each element enters the viewport. Skipped entirely (content stays
  // visible) when the user prefers reduced motion or IntersectionObserver
  // is unavailable.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce && 'IntersectionObserver' in window) {
    const targets = document.querySelectorAll<HTMLElement>(
      '.case-studies .section-head, .case-studies .project-card'
    );
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        });
      },
      { rootMargin: '0px 0px -3% 0px', threshold: 0.05 }
    );
    targets.forEach((el, i) => {
      el.setAttribute('data-reveal', '');
      // Small stagger between the two cards of a row.
      if (el.classList.contains('project-card')) el.style.transitionDelay = `${(i % 2) * 0.1}s`;
      io.observe(el);
    });
  }
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    /* Fills the first screen below the 68px sticky header. */
    min-height: calc(100svh - var(--header-h));
    padding-top: clamp(32px, 5vw, 80px);
    padding-bottom: clamp(24px, 3vw, 48px);
  }
  /* Experimental texture background (light gray halftone). Light theme shows
     it as-is; dark theme inverts it so it reads as a dark texture. */
  .hero::before {
    content: '';
    position: absolute;
    inset: calc(var(--header-h) * -1) 0 0 0; /* up behind the fixed header */
    z-index: 0;
    background: url('/images/hero/hero-texture.jpg') center / cover no-repeat;
    opacity: 0.85;
    pointer-events: none;
  }
  /* Dark theme: the hero keeps its light look. The light palette is re-applied
     locally (so text, tags and CTA read dark on the light texture) and the
     texture is backed by the paper color instead of the black page. */
  :global([data-theme='dark']) .hero {
    --bg-page: var(--paper);
    --bg-surface: var(--white);
    --text-primary: var(--navy-900);
    --text-secondary: var(--navy-700);
    --text-muted: var(--navy-500);
    --border-default: var(--border-light);
    --accent-primary: var(--navy-900);
    --accent-cta: var(--navy-900);
    --accent-cta-text: #FFFFFF;
    --accent-highlight: #000000;
    --heading-ink: var(--navy-900);
  }
  :global([data-theme='dark']) .hero::before {
    background-color: var(--paper);
    background-image:
      linear-gradient(rgba(252, 252, 251, 0.15), rgba(252, 252, 251, 0.15)),
      url('/images/hero/hero-texture.jpg');
    opacity: 1;
  }
  :global([data-theme='dark']) .hero-name { color: #14181F; }
  :global([data-theme='dark']) .hero-meta-list li { background: var(--white); }
  /* Entrance: texture fades in while easing down from a slight zoom, then
     headline lines, tags and intro/CTA rise in sequence. Only for users who
     haven't asked for reduced motion. `backwards` keeps the final
     opacity/position from the normal rules (theme-dependent). Uses
     `translate` so it never clashes with the tags' own transform. */
  @keyframes hero-bg-in {
    from { opacity: 0; scale: 1.06; }
  }
  @keyframes hero-rise {
    from { opacity: 0; translate: 0 28px; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero::before {
      animation: hero-bg-in 1.6s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    }
    .hero-line,
    .hero-meta-list,
    .hero-bottom {
      animation: hero-rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    }
    .hero-line:nth-child(1) { animation-delay: 0.15s; }
    .hero-line:nth-child(2) { animation-delay: 0.3s; }
    .hero-meta-list { animation-delay: 0.6s; }
    .hero-bottom { animation-delay: 0.8s; }
  }
  /* Scroll reveal (see script above): only ever hidden when JS has tagged
     the element, so no-JS and reduced-motion users always see the content. */
  :global([data-reveal]:not(.is-in)) {
    opacity: 0;
    translate: 0 16px;
  }
  /* `body.theme-ready *` (global.css) sets a transition on everything, so
     this needs equal-or-higher specificity or the reveal would just snap. */
  :global(body.theme-ready [data-reveal]),
  :global([data-reveal]) {
    transition: var(--transition-theme), opacity 0.6s ease-out, translate 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* Full-bleed section; horizontal margins come from the shared --gutter,
     same as the page container, so hero, header and sections all align.
     Headline pinned to the top, intro + CTA pinned to the bottom. */
  .hero-stack {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-8);
    text-align: left;
    padding-inline: var(--gutter);
  }
  .hero-headline {
    position: relative;
  }
  .hero-name {
    font-size: var(--text-h1);
    line-height: 0.92;
    letter-spacing: -0.055em;
    margin: 0;
  }
  .hero-line {
    display: block;
  }
  :global([data-theme='light']) .hero-name {
    color: #14181F;
  }
  /* Tags as a compact 2-3 grid placed right after the end of "Visual
     Designer" (5.785em is that line's width), bottom edge on that line's baseline.
     em is relative to the headline size, so it tracks the fluid font-size. */
  .hero-meta-list {
    position: absolute;
    font-size: var(--text-h1);
    left: calc(5.785em + 32px);
    top: 1.727em; /* baseline of the second headline line */
    transform: translateY(-100%);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
    margin: 0;
  }
  .tag-row {
    display: flex;
    gap: 8px 14px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .hero-meta-list li {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--text-primary);
    background: transparent;
    border: 1.5px solid var(--text-primary);
    border-radius: 999px;
    /* 2 rows tuned so the block matches the x-height of the adjacent lowercase letters. */
    padding: 8.1px 15px;
    white-space: nowrap;
  }
  :global([data-theme='light']) .hero-meta-list li {
    background: var(--white);
  }
  .hero-meta-list li.tag-br { display: none; }
  .hero-bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-6);
  }
  .hero-intro {
    font-family: var(--font-headline);
    font-size: 22px;
    line-height: 1.25;
    color: var(--text-primary);
    max-width: 30ch;
    margin: 0;
  }
  /* Lead in full contrast, the rest in a softer gray (theme-aware token). */
  .hero-intro { color: var(--text-muted); }
  .hero-intro-lead { color: var(--text-primary); }
  /* Location sentence wraps as one unit, so it drops to the last line intact. */
  .hero-location { display: inline-block; }
  /* The Spanish copy is longer: give it more measure so it stays within 3 lines on desktop. */
  :global(html[lang='es']) .hero-intro {
    max-width: 40ch;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    flex-shrink: 0;
    padding: 0;
    font-family: var(--font-headline);
    font-size: 22px;
    line-height: 1.25;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }
  /* Text link: underlined, black in light mode / white in dark (text-primary). */
  .btn-primary {
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.2em;
  }
  @media (hover: hover) {
    .btn-primary:hover { opacity: 0.6; }
  }
  /* Not enough room beside the headline (needs ~1300px): tags drop below it as one wrapping
     row (rows flattened with display: contents). */
  @media (max-width: 1320px) {
    .hero-meta-list {
      position: static;
      font-size: 16px;
      transform: none;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 4px 14px;
      margin: clamp(24px, 3vw, 48px) 0 0;
    }
    .tag-row { display: contents; }
  }
  /* Process + FAQ: the column-1 heading follows the reader through the
     long content in columns 2-3, bounded by the section's own grid. */
  @media (min-width: 901px) {
    .case-studies .section-head,
    .process .section-head,
    .faq .section-head {
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
    }
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }
  .process-more-link {
    display: inline-flex;
    margin-top: var(--space-4);
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 0.8rem;
    color: var(--text-secondary);
    white-space: nowrap;
  }
  .process-more-link svg {
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }
  .process-more-link:hover {
    color: var(--accent-highlight);
  }
  .process-more-link:hover svg {
    transform: translateX(2px);
  }
  .process, .case-studies, .faq {
    padding-block: var(--space-16);
    border-top: 1px solid var(--border-default);
  }
  .process h2, .case-studies h2, .faq h2 { margin-bottom: 0; font-size: 32px; }

  .faq-item {
    border-bottom: 1px solid var(--border-default);
  }
  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
    font-family: var(--font-headline);
    font-size: 1.3rem;
    color: var(--text-primary);
    cursor: pointer;
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary:focus-visible {
    outline: 2px solid var(--accent-highlight);
    outline-offset: 4px;
  }
  .faq-chevron {
    flex-shrink: 0;
    color: var(--text-muted);
    transition: transform 0.2s ease;
  }
  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }
  .faq-item p {
    padding-bottom: var(--space-4);
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .process-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }
  .process-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6) var(--space-6);
    background: var(--bg-surface);
  }
  /* Header row: small icon on the left, oversized faint ordinal on the right.
     The ordinal is fully inside the card (no clipping) so every digit renders whole. */
  .card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }
  .card-icon {
    /* Same tone family as the faint ordinal, but dark enough to read as an icon. */
    color: color-mix(in srgb, var(--text-primary) 28%, transparent);
    flex-shrink: 0;
  }
  .card-icon :global(svg) {
    display: block;
    width: 40px;
    height: 40px;
  }
  .card-num {
    font-family: var(--font-headline);
    font-size: 88px;
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: var(--text-primary);
    opacity: 0.08;
    pointer-events: none;
    user-select: none;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    :global(body.theme-ready) .card-num,
    .card-num {
      transition: opacity 0.3s ease, transform 0.3s ease;
    }
    .process-card:hover .card-num {
      opacity: 0.14;
      transform: translateY(-3px);
    }
  }
  .card-text h3 {
    font-family: var(--font-headline);
    font-size: 22px;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }
  .process-card p { font-size: 0.95rem; }

  .project-grid {
    column-count: 2;
    column-gap: var(--space-4);
  }
  .project-card {
    display: block;
    break-inside: avoid;
    margin-bottom: var(--space-4);
  }
  .project-thumb {
    position: relative;
    overflow: hidden;
    background: var(--bg-surface-subtle);
    border: 1px solid var(--border-default);
    margin-bottom: var(--space-3);
  }
  /* Varied ratios per card, cycling by index — this is what makes the
     masonry cascade read clearly instead of a uniform grid. */
  .thumb-ratio-0 { aspect-ratio: 4 / 3; }
  .thumb-ratio-1 { aspect-ratio: 3 / 4; }
  .thumb-ratio-2 { aspect-ratio: 1 / 1; }
  .thumb-ratio-3 { aspect-ratio: 16 / 10; }
  .project-thumb.has-image { background: none; }
  .project-thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .project-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    background: rgba(0, 0, 0, 0.45);
    color: var(--white);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  /* Same pill as the hero tags (mono, uppercase, outlined, fully rounded), eye
     icon first. Light: white fill. Dark: transparent, white outline. */
  .overlay-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--text-primary);
    background: transparent;
    border: 1.5px solid var(--text-primary);
    border-radius: 999px;
    padding: 8.1px 15px;
  }
  .overlay-pill svg { flex-shrink: 0; }
  :global([data-theme='light']) .overlay-pill {
    background: var(--white);
  }
  .project-card:hover .project-overlay,
  .project-card:focus-visible .project-overlay {
    opacity: 1;
    transform: translateY(0);
  }
  .project-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }
  .project-title {
    font-family: var(--font-headline);
    font-size: 18px;
    color: var(--text-primary);
    line-height: 1.3;
  }
  .project-impact {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: var(--space-2);
  }
  .project-impact::before {
    content: '+';
    color: var(--accent-highlight);
    font-size: 1.3em;
    font-weight: 700;
  }


  @media (max-width: 780px) {
    /* 15vw makes the longest line ("Visual Designer") fill the width; it still fits down to 320px. */
    .hero-name { font-size: 15vw; }
  }

  @media (max-width: 780px) {
    /* Phone hero: giant headline pinned under the navbar; tags, intro and
       CTA stacked at the bottom of the viewport, negative space between. */
    .hero-headline { display: contents; }
    .hero-stack { justify-content: flex-start; gap: var(--space-4); }
    .hero-name { order: 1; }
    .hero-meta-list {
      order: 2;
      font-size: 12px;
      gap: 4px 8px;
      margin: 0;
    }
    .hero-meta-list li {
      /* Scales with the viewport so two tags always fit per row
         (longest pair is the ES one: ~32em wide plus padding and gap). */
      font-size: clamp(7.5px, calc((100vw - 80px) / 32), 9.9px);
      padding: 5px 8px;
      border-width: 1px;
