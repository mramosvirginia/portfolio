---
import Layout from '../../../layouts/Layout.astro';
import CaseStudy from '../../../components/CaseStudy.astro';
import { home } from '../../../data/site';
import { rebrandingQdq } from '../../../data/case-studies/rebranding-qdq';

const t = home.es;
---

<Layout
  locale="es"
  title="Rebranding qdq — Virginia Miner"
  description={rebrandingQdq.es.title}
>
  <CaseStudy locale="es" study={rebrandingQdq.es} />
  <Fragment slot="footer">
    <p>{t.footerTagline}</p>
  </Fragment>
</Layout>
