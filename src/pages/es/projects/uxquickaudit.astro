---
import Layout from '../../../layouts/Layout.astro';
import CaseStudy from '../../../components/CaseStudy.astro';
import { home } from '../../../data/site';
import { uxquickaudit } from '../../../data/case-studies/uxquickaudit';

const t = home.es;
---

<Layout
  locale="es"
  title="UX QuickAudit — Virginia Miner"
  description={uxquickaudit.es.title}
>
  <CaseStudy locale="es" study={uxquickaudit.es} />
  <Fragment slot="footer">
    <p>{t.footerTagline}</p>
  </Fragment>
</Layout>
