---
import Layout from '../../../layouts/Layout.astro';
import CaseStudy from '../../../components/CaseStudy.astro';
import { home } from '../../../data/site';
import { caseSeo } from '../../../lib/caseSeo';
import { rebrandingQdq } from '../../../data/case-studies/rebranding-qdq';

const t = home.en;
const seo = await caseSeo(rebrandingQdq.en);
---

<Layout
  locale="en"
  title={seo.title}
  description={seo.description}
  image={seo.image}
>
  <CaseStudy locale="en" study={rebrandingQdq.en} />
  <Fragment slot="footer">
    <p>{t.footerTagline}</p>
  </Fragment>
</Layout>
