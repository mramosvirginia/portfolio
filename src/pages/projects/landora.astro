---
import Layout from '../../layouts/Layout.astro';
import CaseStudy from '../../components/CaseStudy.astro';
import { home } from '../../data/site';
import { landora } from '../../data/case-studies/landora';

const t = home.en;
---

<Layout
  locale="en"
  title="Landora — Virginia Miner"
  description={landora.en.title}
>
  <CaseStudy locale="en" study={landora.en} />
  <Fragment slot="footer">
    <p>{t.footerTagline}</p>
  </Fragment>
</Layout>
