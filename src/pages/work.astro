---
import Layout from '../layouts/Layout.astro';
import Work from '../components/Work.astro';
import { home } from '../data/site';

const t = home.en;
---

<Layout
  locale="en"
  title="Work — Virginia Miner"
  description="Selected product, UX/UI and visual design work by Virginia Miner."
>
  <Work locale="en" />
  <Fragment slot="footer">
    <p>{t.footerTagline}</p>
  </Fragment>
</Layout>
